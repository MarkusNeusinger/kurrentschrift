# package.json declares `engines.node >= 22.22.2` and nothing enforced it, so a
# Node 20 machine installed happily and then failed deep inside the build:
# `npm run build` runs the prerender through `node --experimental-strip-types`,
# a flag that does not exist before 22.6, and the message is
# "node: bad option" with no mention of the version. Enforced here, the
# refusal happens at install time and says which version is wanted.
# `.nvmrc` beside this file names it for `nvm use`; CI and app/Dockerfile
# already pin 22.
#
# The patch-level floor is the dependency tree's, not a preference: since jsdom
# joined the devDependencies the tree's highest 22-line requirement is
# `^22.22.2`, and with this switch on, a declared `>=22` would let a Node 22.5
# machine past the manifest only to be refused by that package. The floor a
# reader sees has to be the floor `npm ci` actually applies.
engine-strict=true

# The audit step of a local install takes minutes and reports the registry's
# view of dev dependencies, which the deployed bundle does not contain. CI runs
# `npm audit --omit=dev` as its own check instead.
audit=false
fund=false
