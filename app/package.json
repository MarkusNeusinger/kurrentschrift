{
  "name": "kurrentschrift-app",
  "version": "0.1.0",
  "description": "kurrentschrift.ink — the public site for reading and writing German Kurrent and Sütterlin, plus the admin workbench behind /admin.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "prebuild": "npm run prerender",
    "build": "tsc && vite build",
    "prerender": "node --experimental-strip-types scripts/build-prerender.mjs && node --experimental-strip-types scripts/check-sitemap-lastmod.mjs",
    "preview": "vite preview --host",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "fonts:sync": "node scripts/sync-fonts.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "^10.8.0"
    }
  }
}
