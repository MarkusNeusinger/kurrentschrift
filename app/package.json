{
  "name": "kurrentschrift-app",
  "version": "0.1.0",
  "description": "kurrentschrift admin UI — canonical extraction from the Loth 1866 chart with stylus input.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "prebuild": "npm run schriftkunde:md",
    "build": "tsc && vite build",
    "schriftkunde:md": "node scripts/build-schriftkunde-md.mjs",
    "preview": "vite preview --host",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "fonts:sync": "node scripts/sync-fonts.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "^10.8.0"
    }
  }
}
