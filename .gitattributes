# Default: auto-detect, normalize to LF in repo.
* text=auto eol=lf

# Source code — explicit for clarity even though auto would catch them.
*.py    text diff=python
*.md    text
*.yml   text
*.yaml  text
*.toml  text
*.json  text
*.cff   text

# The changelog merges by UNION: every PR adds bullets under [Unreleased],
# and two PRs adding at the same spot is not a conflict — git keeps both
# sides (ours first, then theirs). The one thing union cannot judge is a
# line that BOTH sides changed: it would appear twice, so the changelog
# rule is "add on top of your category, never rewrite existing lines in
# passing" (CLAUDE.md, working guardrails).
CHANGELOG.md merge=union

# SVG is XML text — keep diffable.
*.svg   text

# Binary assets — never CRLF-normalize, never line-diff.
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
*.pdf   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.tar   binary
*.gz    binary
